        {
          "type": "table",
          "headers": [
            "Operación",
            "Definición",
            "Dominio"
          ],
          "rows": [
            [
              "(f + g)(x)",
              "f(x) + g(x)",
              "Dom f ∩ Dom g"
            ],
            [
              "(f·g)(x)",
              "f(x)·g(x)",
              "Dom f ∩ Dom g"
            ],
            [
