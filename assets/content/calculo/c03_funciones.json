            "(3, 32)",
            "(−3, −4)",
            "(−6, 5)",
            "(3, −4)"
          ],
          "correct": 1,
          "explanation": "xv = −6/2 = −3; f(−3) = 9 − 18 + 5 = −4."
        },
        {
          "type": "quiz",
          "question": "f(x) = −2x² + 3 abre hacia:",
          "options": [
            "Arriba",
            "Abajo",
            "La derecha",
            "No es parábola"
          ],
          "correct": 1,
          "explanation": "a < 0."
        },
        {
          "type": "quiz",
          "question": "Forma canónica de x² − 2x + 5:",
          "options": [
            "(x − 1)² + 4",
            "(x + 1)² + 4",
            "(x − 2)² + 1",
            "(x − 1)² + 5"
          ],
          "correct": 0,
          "explanation": "x² − 2x + 1 − 1 + 5."
        },
        {
          "type": "quiz",
          "question": "Una parábola con a < 0 tiene:",
          "options": [
            "Un mínimo",
            "Un máximo",
            "Ninguno",
            "Dos máximos"
          ],
          "correct": 1,
          "explanation": "Abre hacia abajo."
        }
      ]
    },
