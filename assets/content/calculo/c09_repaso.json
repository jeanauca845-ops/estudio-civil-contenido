  "description": "Resumen de todas las fórmulas, errores típicos y práctica mixta",
  "lessons": [
    {
      "id": "l01-formulario",
      "title": "Formulario completo de Cálculo 1",
      "summary": "Todo en una sola página para repasar antes del examen.",
      "minutes": 10,
      "blocks": [
        {
          "type": "table",
          "headers": [
            "Tema",
            "Fórmula"
          ],
          "rows": [
            [
              "Recta",
              "y − y₁ = m(x − x₁);  m = (y₂ − y₁)/(x₂ − x₁)"
            ],
            [
              "Cuadrática",
              "x = [−b ± √(b² − 4ac)]/(2a);  vértice x = −b/(2a)"
            ],
            [
              "Logaritmos",
              "ln(ab) = ln a + ln b;  ln(a/b) = ln a − ln b;  ln aⁿ = n ln a"
            ],
            [
              "Trigonometría",
              "sen² + cos² = 1;  sen 2x = 2 sen x cos x;  cos 2x = cos² − sen²"
            ],
            [
              "Límites notables",
              "sen x/x → 1;  (1 − cos x)/x → 0;  (1 + 1/x)ˣ → e;  (eˣ − 1)/x → 1"
            ],
            [
              "Continuidad",
              "f(a) existe, lím f existe, lím f = f(a)"
            ],
            [
              "Definición de derivada",
              "f′(x) = lím (h→0) [f(x + h) − f(x)]/h"
            ],
            [
              "Potencia",
              "(xⁿ)′ = n xⁿ⁻¹"
            ],
            [
              "Producto / cociente",
              "(fg)′ = f′g + fg′;  (f/g)′ = (f′g − fg′)/g²"
            ],
            [
              "Cadena",
              "[f(g(x))]′ = f′(g(x))·g′(x)"
            ],
            [
              "Exp / log",
              "(eᵘ)′ = eᵘu′;  (aᵘ)′ = aᵘ ln a·u′;  (ln u)′ = u′/u"
            ],
            [
              "Trig",
              "(sen u)′ = cos u·u′;  (cos u)′ = −sen u·u′;  (tan u)′ = sec²u·u′"
            ],
            [
              "Trig inversas",
              "(arcsen u)′ = u′/√(1 − u²);  (arctan u)′ = u′/(1 + u²)"
            ],
            [
              "Implícita",
              "Derivar todo respecto a x; cada término con y lleva y′; despejar y′"
            ],
            [
              "Tangente",
              "y − f(a) = f′(a)(x − a)"
            ],
            [
              "Extremos",
              "f′ = 0 o no existe; f″ > 0 mínimo, f″ < 0 máximo"
            ],
            [
              "Valor medio",
              "f′(c) = [f(b) − f(a)]/(b − a)"
            ],
            [
              "L'Hôpital",
              "0/0 o ∞/∞: lím f/g = lím f′/g′"
            ],
            [
              "Diferencial",
              "dy = f′(x)dx;  L(x) = f(a) + f′(a)(x − a)"
            ],
            [
              "Newton",
              "xₙ₊₁ = xₙ − f(xₙ)/f′(xₙ)"
            ]
          ]
        }
      ]
    },
    {
      "id": "l02-errores",
      "title": "Los 15 errores más comunes",
      "summary": "Lo que más hace perder puntos en los exámenes de Cálculo 1.",
      "minutes": 10,
      "blocks": [
        {
          "type": "table",
          "headers": [
            "Error",
            "Correcto"
          ],
          "rows": [
            [
              "(a + b)² = a² + b²",
              "(a + b)² = a² + 2ab + b²"
            ],
            [
              "√(a + b) = √a + √b",
              "No se separa"
            ],
            [
              "(x + 3)/3 = x (tachar sumandos)",
              "Solo se cancelan factores"
            ],
            [
              "−3² = 9",
              "−3² = −9; (−3)² = 9"
            ],
            [
              "ln(a + b) = ln a + ln b",
              "No existe esa propiedad"
            ],
            [
              "0/0 = 0 o 1",
              "Es una indeterminación: simplificar"
            ],
            [
              "Dividir entre x al resolver",
              "Factorizar: se pierde x = 0"
            ],
            [
              "Multiplicar una inecuación por algo con x",
              "Usar tabla de signos"
            ],
            [
              "(sen 5x)′ = cos 5x",
              "5 cos 5x (falta la cadena)"
            ],
            [
              "(fg)′ = f′g′",
              "f′g + fg′"
            ],
            [
              "(f/g)′ = f′/g′",
              "(f′g − fg′)/g²"
            ],
            [
              "(y²)′ = 2y en implícita",
              "2y·y′"
            ],
            [
              "Reemplazar números antes de derivar en razones relacionadas",
              "Derivar primero, sustituir después"
            ],
            [
              "Olvidar los extremos del intervalo al buscar el máximo absoluto",
              "Evaluar también f(a) y f(b)"
            ],
            [
              "Usar L'Hôpital sin verificar 0/0 o ∞/∞",
              "Sustituir primero siempre"
            ]
          ]
        },
        {
          "type": "quiz",
          "question": "(x + 2)² =",
          "options": [
            "x² + 4",
            "x² + 4x + 4",
            "x² + 2x + 4",
            "2x + 4"
          ],
          "correct": 1,
          "explanation": "Producto notable."
        },
        {
          "type": "quiz",
          "question": "En derivación implícita, (y²)′ =",
          "options": [
            "2y",
            "2y·y′",
            "y′²",
            "2x"
          ],
          "correct": 1,
          "explanation": "Cadena."
        }
      ]
    },
