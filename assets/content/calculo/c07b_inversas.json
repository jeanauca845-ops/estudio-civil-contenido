          ],
          "correct": 1,
          "explanation": "0 < a < 1."
        },
        {
          "type": "quiz",
          "question": "lím (x→−∞) 4ˣ =",
          "options": [
            "+∞",
            "0",
            "1",
            "4"
          ],
          "correct": 1,
          "explanation": "a > 1."
        },
        {
          "type": "quiz",
          "question": "d/dx 7^(3x) =",
          "options": [
