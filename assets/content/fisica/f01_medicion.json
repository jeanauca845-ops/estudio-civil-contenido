      "minutes": 12,
      "blocks": [
        {
          "type": "formula",
          "expression": "N = a × 10ⁿ   con 1 ≤ |a| < 10",
          "caption": "Notación científica. 0,00052 = 5,2 × 10⁻⁴; 6 380 000 m = 6,38 × 10⁶ m."
        },
